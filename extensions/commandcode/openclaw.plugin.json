{
  "id": "commandcode",
  "name": "CommandCode",
  "categories": [
    "models"
  ],
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "commandcode",
    "commandcode-chat",
    "commandcode-anthropic",
    "commandcode-claude"
  ],
